---
import { Image } from 'astro:assets';
import { unsplashCover } from '../lib/cover-credit';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata | string;
  alt: string;
  sizes: string;
  priority?: boolean;
}
const { image, alt, sizes, priority = false } = Astro.props;
---
{typeof image === 'string' ? (
  <img src={unsplashCover(image, 1200)} srcset={[480, 768, 1200, 1600].map(width => `${unsplashCover(image, width)} ${width}w`).join(', ')}
    width="1200" height="675" sizes={sizes} alt={alt} loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined} decoding="async" />
) : image.format === 'gif' ? (
  <img src={image.src} width={image.width} height={image.height} alt={alt}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" />
) : (
  <Image src={image} alt={alt} layout="constrained" format="webp" sizes={sizes} priority={priority} />
)}
