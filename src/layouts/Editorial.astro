---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '../styles/site.css';
import '../styles/journal.css';
import appearance from '../data/appearance.json';
import { isPalette } from '../lib/appearance';
import { name, description as siteDescription, url } from '../lib/posts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  published?: Date;
  noindex?: boolean;
  workspace?: boolean;
}

const { title, description = siteDescription, image, published, noindex = false, workspace = false } = Astro.props;
const pageTitle = title ? `${title} | ${name}` : name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-palette={isPalette(appearance.palette) ? appearance.palette : 'ocean'}>
  <head>
    <meta charset="utf-8" />
    <slot name="head" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <script is:inline src={url('theme.js')}></script>
    <meta property="og:title" content={pageTitle} />
    <meta property="og:site_name" content={name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="frame header-inner">
        <a class="wordmark" href={url()}>{name}</a>
        <nav class="site-nav" aria-label="Main navigation">
          {!workspace && <a href={url() + '#stories'}>Stories</a>}
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Dark mode" aria-pressed="false" hidden>
            <span class="theme-moon" aria-hidden="true">☾</span>
            <span class="theme-sun" aria-hidden="true">☼</span>
          </button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    {!workspace && <footer class="site-footer"><div class="frame footer-inner">{name}</div></footer>}
  </body>
</html>
