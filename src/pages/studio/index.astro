---
import Editorial from '../../layouts/Editorial.astro';
import '../../styles/studio.css';
---
<Editorial title="Writing studio" noindex>
  <meta slot="head" http-equiv="Content-Security-Policy"
    content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data: https:; connect-src https://api.github.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; base-uri 'none'; form-action 'none'; object-src 'none'" />
  <div class="frame studio">
    <header class="studio-heading">
      <div><h1>Writing studio</h1><p>Write and publish on Kanishk’s Kaleidoscope.</p></div>
      <div class="studio-view-controls">
        <button type="button" id="focus-mode" class="studio-secondary" aria-pressed="false">Focus mode</button>
        <button type="button" id="preview" class="studio-secondary" aria-pressed="false">Preview</button>
        <button type="button" form="article-form" id="publish-top" class="studio-primary">Publish</button>
      </div>
    </header>
    <div class="studio-layout">
      <aside class="studio-sidebar" aria-label="Articles and publishing">
        <button type="button" id="new-post" class="studio-secondary">New article</button>
        <section>
          <h2>On this device</h2>
          <ul id="draft-list"></ul>
        </section>
        <section>
          <h2>On GitHub</h2>
          <ul id="remote-list"></ul>
        </section>
        <section id="outline-panel">
          <h2>Article outline</h2>
          <ul id="article-outline"></ul>
        </section>
        <section>
          <h2>Publishing access</h2>
          <details id="connect-details">
            <summary>Connect your GitHub account</summary>
            <p>Create a fine-grained token in GitHub for this repository with <strong>Contents: Read and write</strong>. Enter it here each writing session to publish.</p>
            <a class="studio-link" href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">Create token on GitHub ↗</a>
            <form id="connect-form" autocomplete="off">
              <label for="github-token">Repository token</label>
              <input id="github-token" type="password" autocomplete="off" spellcheck="false" required />
              <button type="submit" class="studio-secondary">Connect</button>
            </form>
          </details>
          <p id="connected" hidden>Connected as <strong>kanishkmunot</strong>. <button type="button" id="disconnect" class="studio-link">Disconnect</button></p>
        </section>
      </aside>
      <section class="studio-paper" aria-label="Article editor">
        <form id="article-form">
          <div class="studio-fields">
            <label for="article-title">Title</label>
            <input id="article-title" type="text" maxlength="180" placeholder="Article title" />
            <label for="article-subtitle">Subtitle <span>(optional)</span></label>
            <input id="article-subtitle" type="text" maxlength="280" />
          </div>
          <div class="studio-compose">
            <div class="studio-toolbar" aria-label="Text formatting">
              <button type="button" id="insert-block" class="insert-block">＋ Insert</button>
              <span class="toolbar-separator" aria-hidden="true"></span>
              <button type="button" data-editor-action="undo" aria-label="Undo" title="Undo">↶</button>
              <button type="button" data-editor-action="redo" aria-label="Redo" title="Redo">↷</button>
              <span class="toolbar-separator" aria-hidden="true"></span>
              <button type="button" data-editor-action="bold" aria-label="Bold" title="Bold (Ctrl/⌘ B)"><strong>B</strong></button>
              <button type="button" data-editor-action="italic" aria-label="Italic" title="Italic (Ctrl/⌘ I)"><em>I</em></button>
              <button type="button" data-editor-action="underline" aria-label="Underline" title="Underline"><u>U</u></button>
              <button type="button" data-editor-action="strike" aria-label="Strikethrough" title="Strikethrough"><s>S</s></button>
              <button type="button" data-editor-action="code" aria-label="Inline code" title="Inline code">&lt;/&gt;</button>
              <button type="button" data-editor-action="link" aria-label="Link" title="Link (Ctrl/⌘ K)">Link</button>
              <span class="toolbar-spacer"></span>
              <button type="button" id="markdown-mode" aria-pressed="false">Markdown</button>
              <button type="button" id="shortcut-help" aria-label="Keyboard shortcuts" title="Keyboard shortcuts">?</button>
            </div>
            <div id="table-tools" class="studio-toolbar" aria-label="Table controls" hidden>
              <button type="button" data-editor-action="addRow">Add row</button>
              <button type="button" data-editor-action="addColumn">Add column</button>
              <button type="button" data-editor-action="deleteRow">Remove row</button>
              <button type="button" data-editor-action="deleteColumn">Remove column</button>
              <button type="button" data-editor-action="deleteTable">Remove table</button>
            </div>
            <div id="editor" class="prose studio-editor"></div>
            <textarea id="markdown-source" class="markdown-source" aria-label="Article Markdown" rows="14" hidden></textarea>
            <div id="selection-menu" class="selection-menu" role="toolbar" aria-label="Format selection" hidden>
              <button type="button" data-editor-action="bold" aria-label="Selection bold"><strong>B</strong></button>
              <button type="button" data-editor-action="italic" aria-label="Selection italic"><em>I</em></button>
              <button type="button" data-editor-action="underline" aria-label="Selection underline"><u>U</u></button>
              <button type="button" data-editor-action="link" aria-label="Add link to selection">Link</button>
            </div>
            <div class="composer-footer">
              <span id="writing-stats">0 words</span>
              <span id="draft-state">Drafts autosave on this device</span>
            </div>
          </div>
          <input id="inline-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" multiple hidden />
          <details class="studio-metadata">
            <summary>Article settings and media</summary>
            <div class="studio-fields">
              <label for="article-description">Short description</label>
              <textarea id="article-description" rows="2" maxlength="320"></textarea>
              <label for="article-date">Publication date</label>
              <input id="article-date" type="date" />
              <label for="cover-file">Cover image</label>
              <input id="cover-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
              <p id="cover-status"></p>
              <button id="remove-cover" class="studio-link" type="button" hidden>Remove cover</button>
              <label for="cover-alt">Cover image alt text</label>
              <input id="cover-alt" type="text" />
              <label for="cover-caption">Cover image caption</label>
              <input id="cover-caption" type="text" />
              <label for="article-videos">YouTube or Vimeo URLs <span>(one per line)</span></label>
              <textarea id="article-videos" rows="2"></textarea>
              <label class="studio-checkbox"><input id="article-featured" type="checkbox" /> Feature on homepage</label>
            </div>
          </details>
          <div class="studio-publish">
            <button id="save-draft" type="button" class="studio-secondary">Save draft</button>
            <button id="publish" type="submit" class="studio-primary">Publish</button>
            <button id="unpublish" type="button" class="studio-link" hidden>Unpublish</button>
            <button id="delete-post" type="button" class="studio-link studio-danger" hidden>Delete</button>
          </div>
        </form>
        <section id="article-preview" class="studio-preview" aria-label="Article preview" hidden>
          <div class="preview-controls" aria-label="Preview viewport">
            <button type="button" class="studio-secondary" id="preview-wide" aria-pressed="true">Desktop</button>
            <button type="button" class="studio-secondary" id="preview-narrow" aria-pressed="false">Mobile</button>
          </div>
          <div id="preview-canvas" class="reading preview-canvas">
          <header class="article-header">
            <time id="preview-date"></time>
            <h1 id="preview-title"></h1>
            <p class="subtitle" id="preview-subtitle"></p>
          </header>
          <figure id="preview-cover" hidden><img id="preview-image" alt="" /><figcaption id="preview-caption"></figcaption></figure>
          <div id="preview-body" class="prose"></div>
          <div id="preview-videos"></div>
          </div>
        </section>
        <p id="studio-status" class="studio-status" role="status" aria-live="polite"></p>
      </section>
    </div>
    <dialog id="blocks-dialog" class="studio-dialog" aria-labelledby="blocks-title">
      <div class="dialog-head"><h2 id="blocks-title">Insert a block</h2><button type="button" class="studio-secondary" data-close-dialog>Close</button></div>
      <label for="block-search">Search blocks</label>
      <input type="search" id="block-search" placeholder="Try heading, image, or code" autocomplete="off" />
      <div id="block-options" class="block-options"></div>
    </dialog>
    <dialog id="link-dialog" class="studio-dialog" aria-labelledby="link-title">
      <div class="dialog-head"><h2 id="link-title">Add a link</h2><button type="button" class="studio-secondary" data-close-dialog>Close</button></div>
      <form id="link-form" class="studio-fields">
        <label for="link-value">Link URL</label>
        <input id="link-value" type="url" placeholder="https://example.com" />
        <div class="dialog-actions"><button type="submit" class="studio-primary">Apply link</button><button type="button" id="unlink" class="studio-link">Remove link</button></div>
      </form>
    </dialog>
    <dialog id="image-dialog" class="studio-dialog" aria-labelledby="image-title">
      <div class="dialog-head"><h2 id="image-title">Insert image</h2><button type="button" class="studio-secondary" data-close-dialog>Close</button></div>
      <form id="image-form" class="studio-fields">
        <p id="image-name"></p>
        <label for="inline-alt">Alternative text</label>
        <input id="inline-alt" type="text" />
        <label for="inline-caption">Caption <span>(optional)</span></label>
        <input id="inline-caption" type="text" />
        <div class="dialog-actions"><button type="submit" class="studio-primary">Insert</button></div>
      </form>
    </dialog>
    <dialog id="shortcuts-dialog" class="studio-dialog" aria-labelledby="shortcuts-title">
      <div class="dialog-head"><h2 id="shortcuts-title">Keyboard shortcuts</h2><button type="button" class="studio-secondary" data-close-dialog>Close</button></div>
      <dl class="studio-shortcuts">
        <dt>Bold</dt><dd><kbd>Ctrl/⌘</kbd> <kbd>B</kbd></dd>
        <dt>Italic</dt><dd><kbd>Ctrl/⌘</kbd> <kbd>I</kbd></dd>
        <dt>Underline</dt><dd><kbd>Ctrl/⌘</kbd> <kbd>U</kbd></dd>
        <dt>Add or edit link</dt><dd><kbd>Ctrl/⌘</kbd> <kbd>K</kbd></dd>
        <dt>Save draft</dt><dd><kbd>Ctrl/⌘</kbd> <kbd>S</kbd></dd>
        <dt>Insert a block</dt><dd><kbd>/</kbd> on an empty line</dd>
      </dl>
    </dialog>
  </div>
</Editorial>
<script>
  import { startStudio } from '../../studio/editor';
  startStudio();
</script>
