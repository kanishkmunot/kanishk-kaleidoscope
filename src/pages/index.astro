---
import Editorial from '../layouts/Editorial.astro';
import Story from '../components/Story.astro';
import { description, name, publishedPosts } from '../lib/posts';

const posts = await publishedPosts();
const feature = posts.find(post => post.data.featured) || posts[0];
const latest = posts.filter(post => post.id !== feature?.id);
---
<Editorial>
  <div class="frame">
    <section class="masthead" aria-labelledby="site-title">
      <h1 id="site-title">{name}</h1>
      <p>{description}</p>
    </section>
    {feature ? (
      <>
        <section class="story-section" aria-labelledby="featured-heading">
          <h2 class="section-heading" id="featured-heading">Featured</h2>
          <Story post={feature} featured />
        </section>
        {latest.length > 0 && <section class="story-section" aria-labelledby="latest-heading">
          <h2 class="section-heading" id="latest-heading">Latest stories</h2>
          <div class="story-grid">{latest.map(post => <Story post={post} />)}</div>
        </section>}
      </>
    ) : (
      <section class="story-section" aria-labelledby="latest-heading">
        <h2 class="section-heading" id="latest-heading">Latest stories</h2>
        <div class="empty-state"><p>No articles yet.</p></div>
      </section>
    )}
  </div>
</Editorial>
