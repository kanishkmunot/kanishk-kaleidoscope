---
import { Image } from 'astro:assets';
import Editorial from '../layouts/Editorial.astro';
import Story from '../components/Story.astro';
import prism from '../assets/prism.webp';
import { name, publishedPosts } from '../lib/posts';

const posts = await publishedPosts();
const feature = posts.find(post => post.data.featured) || posts[0];
const latest = posts.filter(post => post.id !== feature?.id);
---
<Editorial>
  <div class="frame journal">
    <section class="journal-hero" aria-labelledby="site-title">
      <div class="journal-intro">
        <p class="journal-kicker">A personal journal</p>
        <h1 id="site-title">{name}</h1>
        <p class="journal-deck">Ideas, experiences, and different ways of seeing everyday things.</p>
        <div class="journal-actions">
          <a class="journal-button" href="#stories">Explore stories <span aria-hidden="true">↓</span></a>
          <span class="journal-byline">By Kanishk Munot</span>
        </div>
      </div>
      <div class="journal-art">
        <Image src={prism} alt="Optical glass prisms refract orange and violet light" sizes="(max-width: 760px) 100vw, 600px" layout="constrained" priority />
      </div>
    </section>

    <section class="story-section journal-stories" id="stories" aria-labelledby="stories-heading">
      <div class="section-title">
        <h2 id="stories-heading">From the journal</h2>
      </div>
      {feature ? (
        <>
          <Story post={feature} featured />
          {latest.length > 0 && <div class="story-grid archive-grid">{latest.map(post => <Story post={post} />)}</div>}
        </>
      ) : <div class="empty-state"><p>No articles yet.</p></div>}
    </section>

  </div>
</Editorial>
